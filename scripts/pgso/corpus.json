{
  "version": 1,
  "intentional_exclusions": {
    "ci-shards.test.ts": "The suite validates the E2E shard planner rather than lia runtime behavior.",
    "context-limits-live.test.ts": "The suite requires a real model credential and live provider responses.",
    "web-fetch-live.test.ts": "The suite requires explicit live-network opt-in.",
    "web-search-live.test.ts": "The suite requires a real model credential and live provider responses."
  },
  "defaults": {
    "cwd": "tests/e2e",
    "env_set": {
      "LIA_AUTO_UPGRADE": "0",
      "LIA_SOUND": "0"
    },
    "env_unset": [
      "AI_GATEWAY_API_KEY",
      "VERCEL_OIDC_TOKEN"
    ],
    "timeout_seconds": 1800,
    "requires_tmux": true
  },
  "scenarios": [
    {
      "name": "direct-help",
      "argv": ["{binary}", "help"],
      "cwd": ".",
      "env_set": {"LIA_TEST_SKIP_ONBOARDING": "1"},
      "profile_runs": 100,
      "timeout_seconds": 60,
      "requires_tmux": false
    },
    {
      "name": "direct-version",
      "argv": ["{binary}", "--version"],
      "cwd": ".",
      "env_set": {"LIA_TEST_SKIP_ONBOARDING": "1"},
      "timeout_seconds": 60,
      "requires_tmux": false
    },
    {
      "name": "direct-status",
      "argv": ["{binary}", "status", "--json"],
      "cwd": ".",
      "env_set": {"LIA_TEST_SKIP_ONBOARDING": "1"},
      "profile_runs": 100,
      "timeout_seconds": 60,
      "requires_tmux": false
    },
    {
      "name": "direct-doctor",
      "argv": ["{binary}", "doctor", "--json"],
      "cwd": ".",
      "env_set": {"LIA_TEST_SKIP_ONBOARDING": "1"},
      "timeout_seconds": 60,
      "requires_tmux": false
    },
    {
      "name": "direct-sessions",
      "argv": ["{binary}", "sessions", "--json"],
      "cwd": ".",
      "env_set": {"LIA_TEST_SKIP_ONBOARDING": "1"},
      "profile_runs": 100,
      "timeout_seconds": 60,
      "requires_tmux": false
    },
    {"name": "e2e-cli", "argv": ["bun", "test", "--max-concurrency", "1", "./cli.test.ts"], "test_file": "cli.test.ts", "allow_keychain": true},
    {"name": "e2e-config-persistence", "argv": ["bun", "test", "--max-concurrency", "1", "./config-persistence.test.ts"], "test_file": "config-persistence.test.ts"},
    {"name": "e2e-auth-refresh", "argv": ["bun", "test", "--max-concurrency", "1", "./auth-refresh.test.ts"], "test_file": "auth-refresh.test.ts"},
    {"name": "e2e-host-managed-auth", "argv": ["bun", "test", "--max-concurrency", "1", "./host-managed-auth.test.ts"], "test_file": "host-managed-auth.test.ts"},
    {"name": "e2e-file-tool-paths", "argv": ["bun", "test", "--max-concurrency", "1", "./file-tool-paths.test.ts"], "test_file": "file-tool-paths.test.ts"},
    {"name": "e2e-file-tool-permissions", "argv": ["bun", "test", "--max-concurrency", "1", "./file-tool-permissions.test.ts"], "test_file": "file-tool-permissions.test.ts"},
    {"name": "e2e-gateway-stream-lifecycle", "argv": ["bun", "test", "--max-concurrency", "1", "./gateway-stream-lifecycle.test.ts"], "test_file": "gateway-stream-lifecycle.test.ts"},
    {"name": "e2e-session-title", "argv": ["bun", "test", "--max-concurrency", "1", "./session-title.test.ts"], "test_file": "session-title.test.ts"},
    {"name": "e2e-web-fetch-fake-network", "argv": ["bun", "test", "--max-concurrency", "1", "./web-fetch-fake-network.test.ts"], "test_file": "web-fetch-fake-network.test.ts"},
    {"name": "e2e-web-search-fake-gateway", "argv": ["bun", "test", "--max-concurrency", "1", "./web-search-fake-gateway.test.ts"], "test_file": "web-search-fake-gateway.test.ts"},
    {"name": "e2e-vision-route-fake-gateway", "argv": ["bun", "test", "--max-concurrency", "1", "./vision-route-fake-gateway.test.ts"], "test_file": "vision-route-fake-gateway.test.ts"},
    {"name": "e2e-acp", "argv": ["bun", "test", "--max-concurrency", "1", "./acp.test.ts"], "test_file": "acp.test.ts"},
    {"name": "e2e-mcp-http", "argv": ["bun", "test", "--max-concurrency", "1", "./mcp-http.test.ts"], "test_file": "mcp-http.test.ts"},
    {"name": "e2e-mcp-legacy-remote", "argv": ["bun", "test", "--max-concurrency", "1", "./mcp-legacy-remote.test.ts"], "test_file": "mcp-legacy-remote.test.ts"},
    {"name": "e2e-mcp-stdio", "argv": ["bun", "test", "--max-concurrency", "1", "./mcp-stdio.test.ts"], "test_file": "mcp-stdio.test.ts"},
    {"name": "e2e-mcp-auth", "argv": ["bun", "test", "--max-concurrency", "1", "./mcp-auth.test.ts"], "test_file": "mcp-auth.test.ts", "allow_keychain": true},
    {"name": "e2e-session-recovery", "argv": ["bun", "test", "--max-concurrency", "1", "./session-recovery.test.ts"], "test_file": "session-recovery.test.ts"},
    {"name": "e2e-permission-errors", "argv": ["bun", "test", "--max-concurrency", "1", "./permission-errors.test.ts"], "test_file": "permission-errors.test.ts"}
  ],
  "verification_scenarios": [
    {"name": "verify-auto-mode-reliability", "argv": ["bun", "test", "--max-concurrency", "1", "./auto-mode-reliability.test.ts"], "test_file": "auto-mode-reliability.test.ts"},
    {"name": "verify-sessions", "argv": ["bun", "test", "--max-concurrency", "1", "./sessions.test.ts"], "test_file": "sessions.test.ts"},
    {"name": "verify-review-model-override", "argv": ["bun", "test", "--max-concurrency", "1", "./review-model-override.test.ts"], "test_file": "review-model-override.test.ts", "requires_tmux": false},
    {"name": "verify-configured-providers", "argv": ["bun", "test", "--max-concurrency", "1", "./configured-providers.test.ts"], "test_file": "configured-providers.test.ts", "requires_tmux": false},
    {"name": "verify-oauth-keychain-migration", "argv": ["bun", "test", "--max-concurrency", "1", "./oauth-keychain-migration.test.ts"], "test_file": "oauth-keychain-migration.test.ts", "allow_keychain": true},
    {"name": "verify-mcp-verbs", "argv": ["bun", "test", "--max-concurrency", "1", "./mcp-verbs.test.ts"], "test_file": "mcp-verbs.test.ts"},
    {"name": "verify-compaction-policy", "argv": ["bun", "test", "--max-concurrency", "1", "./compaction-policy.test.ts"], "test_file": "compaction-policy.test.ts", "requires_tmux": false},
    {"name": "verify-poisoned-repository", "argv": ["bun", "test", "--max-concurrency", "1", "./poisoned-repository.test.ts"], "test_file": "poisoned-repository.test.ts"},
    {"name": "verify-ultrafast-fake-gateway", "argv": ["bun", "test", "--max-concurrency", "1", "./ultrafast-fake-gateway.test.ts"], "test_file": "ultrafast-fake-gateway.test.ts"},
    {"name": "verify-web-fetch-permission-progress", "argv": ["bun", "test", "--max-concurrency", "1", "./web-fetch-permission-progress.test.ts"], "test_file": "web-fetch-permission-progress.test.ts", "requires_tmux": false},
    {"name": "verify-web-search-permission-progress", "argv": ["bun", "test", "--max-concurrency", "1", "./web-search-permission-progress.test.ts"], "test_file": "web-search-permission-progress.test.ts", "requires_tmux": false},
    {"name": "verify-yolo-permission-mode", "argv": ["bun", "test", "--max-concurrency", "1", "./yolo-permission-mode.test.ts"], "test_file": "yolo-permission-mode.test.ts"},
    {"name": "verify-ask-presentation", "argv": ["bun", "test", "--max-concurrency", "1", "./ask-presentation.test.ts"], "test_file": "ask-presentation.test.ts", "requires_tmux": false}
  ]
}
